          "required": [
            "symbol",
            "close",
            "sma200",
            "pctVsSma200",
            "rsi14",
            "previousHighestDailyClose",
            "pctDrawdownFromClosingPeak",
            "oneYearAgoClose",
            "oneYearComparisonDate",
            "yearOverYearPriceReturnPct",
            "dataSources"
