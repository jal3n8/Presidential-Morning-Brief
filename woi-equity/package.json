{
  "name": "woi-equity",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "WOI Equity website and research terminal",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/export-schema.ts && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-file.ts",
    "automation:check": "tsx automation/run.ts --check",
    "automation:run": "tsx automation/run.ts",
    "export-schema": "tsx scripts/export-schema.ts",
    "make-secret": "tsx scripts/make-secret.ts",
    "security:audit": "npm audit --audit-level=low && composer --working-dir=public/api/_lib audit",
    "security:check": "tsx scripts/security-check.ts"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
