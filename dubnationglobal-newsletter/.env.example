# ─────────────────────────────────────────────────────────────────────────────
# DubNationGlobal newsletter page: configuration template. Copy to ".env" locally.
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIC build-time settings (VITE_*): these end up in the website's JavaScript.
# Never put an API key in a VITE_ variable.
VITE_NEWSLETTER_MODE=demo            # demo | endpoint | provider-form
VITE_NEWSLETTER_ENDPOINT=/api/subscribe
VITE_NEWSLETTER_PROVIDER_NAME=       # e.g. Buttondown, Kit, beehiiv (shown in the privacy note)
VITE_NEWSLETTER_PROVIDER_PRIVACY_URL=
VITE_NEWSLETTER_DOUBLE_OPT_IN=true   # must match your provider setting
VITE_PRIVACY_POLICY_URL=
# provider-form mode only: the provider's PUBLIC embed-form URL and email field name
VITE_NEWSLETTER_FORM_ACTION=
VITE_NEWSLETTER_FORM_EMAIL_FIELD=email

# SERVER-ONLY secrets for endpoint mode. Set these in your host's dashboard
# (e.g. Cloudflare Pages → Settings → Variables and Secrets), not in this file
# and never in git. Values come from your provider's API documentation.
# NEWSLETTER_API_URL=
# NEWSLETTER_API_KEY=
# NEWSLETTER_AUTH_HEADER=Authorization
# NEWSLETTER_AUTH_PREFIX=Bearer 
# NEWSLETTER_EMAIL_FIELD=email
# NEWSLETTER_EXTRA_JSON=
# NEWSLETTER_DOUBLE_OPT_IN=true
# NEWSLETTER_DUPLICATE_STATUS=409
# NEWSLETTER_DUPLICATE_MATCH=already
# ALLOWED_ORIGINS=https://dubnationglobal.com,https://www.dubnationglobal.com
